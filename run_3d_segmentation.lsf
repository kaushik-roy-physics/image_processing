#!/bin/bash
#BSUB -J imgproc_3d_seg
#BSUB -o /path/to/file.out
#BSUB -e /path/to/file.err
#
# --- RESOURCE REQUESTS ---
#BSUB -q gpu-b6000
#BSUB -n 8
#BSUB -M 64000
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 16:00
#
# LSF batch script: run the confocal image-processing pipeline (3-D mode) on an
# HPC GPU node. Runs load → segment (Cellpose-SAM 3-D) → extract for every
# image found under the directory configured in config.yaml (input.directory).
#
# Per-image checkpoints (.loaded / .segmented / .extracted) make the job safe to
# resubmit: a re-run only processes images that have not completed. Use --force
# or --force-step on the python call below to recompute.


set -e

# --- HPC ENVIRONMENT SETUP ---
echo "Loading modules..."
module load python3/3.10.7
# cuda/12.8: newest available; cu126 PyTorch wheels require driver >= 12.6.
# Fallback: module load cuda/12.2  +  change index URL below to .../cu121
module load cuda/12.8

# --- PATHS (EDIT THESE) ---
PIPELINE_DIR=/data/Warmflash/pipelines/confocal_image_processing  # holds main.py + config.yaml
CONFIG="$PIPELINE_DIR/config.yaml"        # input.directory inside this file selects the data
VENV_DIR=/scratch/roy2nm/cellpose_venv    # venv on scratch
LOG_DIR=/scratch/roy2nm/logs

cd "$PIPELINE_DIR"
mkdir -p "$LOG_DIR"

# --- PYTHON VIRTUAL ENVIRONMENT SETUP ---
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating Python virtual environment..."
    python3 -m venv "$VENV_DIR"
fi

source "$VENV_DIR/bin/activate"

echo "Installing Python packages..."
pip install --upgrade pip --quiet

# PyTorch with CUDA 12.6 support (compatible with cuda/12.8 driver).
pip install torch torchvision \
    --index-url https://download.pytorch.org/whl/cu126 \
    --quiet

pip install -r "$PIPELINE_DIR/requirements.txt" --quiet

# --- GPU VERIFICATION ---
echo "Verifying PyTorch GPU access..."
python3 -c "
import torch
print(f'PyTorch version : {torch.__version__}')
print(f'CUDA available  : {torch.cuda.is_available()}')
if not torch.cuda.is_available():
    raise RuntimeError('No GPU detected — aborting.')
print(f'GPU             : {torch.cuda.get_device_name(0)}')
print(f'VRAM            : {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB')
"

# --- EXECUTION ---
echo ""
echo "=== Confocal image-processing pipeline (3-D segmentation) ==="
echo "Pipeline dir : $PIPELINE_DIR"
echo "Config       : $CONFIG"
echo ""

# Runs load (read + per-channel TIFFs + MIPs) → segment (Cellpose-SAM 3-D on the
# DAPI z-stack) → extract (per-nucleus intensities + centroids). --seg-mode 3d
# overrides segmentation.mode in the config. Each image writes a self-contained
# result directory next to the source file.
python3 main.py \
    --config "$CONFIG" \
    --seg-mode 3d \
    --steps load segment extract \
    --log-level INFO

echo ""
echo "Pipeline completed."
echo "Per-image results were written alongside each source image (see input.directory)."
